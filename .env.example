# Optional UI Basic Auth. Strongly recommended if you expose the service outside localhost.
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change-this-password

# Backend outbound proxy. Use direct/none to disable, or set a host proxy:
# OUTBOUND_PROXY=http://host.docker.internal:7897
OUTBOUND_PROXY=auto

# Default batch login concurrency.
CONCURRENCY=8
